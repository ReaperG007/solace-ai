# Solace AI — FRONTEND environment (Expo / React Native)
# Exposed via app.config.js (extra.apiUrl) and EXPO_PUBLIC_* inlining.
# Never place server secrets (OPENAI_API_KEY, DATABASE_URL) in this file.

VITE_API_URL=http://localhost:4000
EXPO_PUBLIC_API_URL=http://localhost:4000
EXPO_PUBLIC_APP_NAME=Solace AI
EXPO_PUBLIC_API_TIMEOUT_MS=20000
